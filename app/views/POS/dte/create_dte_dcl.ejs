<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('../../Layouts/Head.ejs') %>
  <link rel="stylesheet" href="assets/libs/choices/choices.min.css">
</head>

<body class="<%= darkMode %>">
  <%- include('../../Layouts/SideBar.ejs') %>
  <div id="main">
    <%- include('../../Layouts/NavBar.ejs') %>

    <div class="container-fluid">
      <div class="card">
        <div class="card-header">
          <h2 class="text-3xl font-bold text-center text-gray-800 mb-8">Documento Contable de Liquidación (DTE Manual)</h2>
        </div>
        <div class="card-body">
          <h4 class="text-center">Datos del Receptor (Afiliado)</h4>
          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label for="nit" class="form-label">NIT / DUI:</label>
                <input type="text" class="form-control" id="nit" placeholder="Ingrese NIT sin guiones" required>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="nrc" class="form-label">NRC (Opcional):</label>
                <input type="text" class="form-control" id="nrc" placeholder="Ingrese NRC">
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="tipoEstablecimiento" class="form-label">Tipo de Establecimiento:</label>
                <select name="tipoEstablecimiento" id="tipoEstablecimiento" class="form-control">
                  <% tiposEstablecimiento.forEach(element => { %>
                  <option value="<%= element.codigo %>"><%= element.Valor %></option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="nombre" class="form-label">Nombre / Razón Social:</label>
                <input type="text" class="form-control" id="nombre" placeholder="Nombre completo o razón social" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="nombreComercial" class="form-label">Nombre Comercial (Opcional):</label>
                <input type="text" class="form-control" id="nombreComercial" placeholder="Nombre comercial">
              </div>
            </div>
          </div>

          <div class="row">
            <div class="form-group mb-3 col-md-12">
              <label for="clientCodActividad">Giro, Actividad Económica del Receptor</label>
              <select class="form-control" id="clientCodActividad">
                <option value="">Seleccione la Actividad Económica</option>
                <% giros.forEach(element => { %>
                <option value="<%= element.codigo %>"><%= element.Valor %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="telefono" class="form-label">Teléfono:</label>
                <input type="text" class="form-control" id="telefono" placeholder="Ingrese teléfono">
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="correo" class="form-label">Correo (Obligatorio):</label>
                <input type="email" class="form-control" id="correo" placeholder="Ingrese correo electrónico" required>
              </div>
            </div>
          </div>

          <h5>Dirección del Receptor</h5>

          <div class="form-group">
            <label for="distrito">Seleccione el Distrito</label>
            <select name="distrito" id="distrito" class="form-control">
              <option value="">Ninguno</option>
            </select>
          </div>

          <div class="form-group">
            <label for="departamento">Departamento</label>
            <select name="departamento" id="departamento" class="form-control" disabled>
              <option value="" selected>Sin Dirección</option>
              <% departamentos.forEach(element => { %>
              <option value="<%= element.codigo %>"><%= element.Valor %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="municipio">Municipio</label>
            <select name="municipio" id="municipio" class="form-control" disabled>
              <option value="" selected>Sin Dirección</option>
            </select>
          </div>

          <div class="form-group">
            <label for="complemento">Complemento de la Dirección:</label>
            <input type="text" name="complemento" id="complemento" class="form-control">
          </div>
        </div>

        <div class="card-body">
          <h4 class="text-center">Cuerpo de la Liquidación Contable</h4>
          <div class="row">
            <div class="col-md-3">
              <div class="form-group">
                <label for="periodoInicio" class="form-label">Fecha Inicio Liquidación:</label>
                <input type="date" class="form-control" id="periodoInicio" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="periodoFin" class="form-label">Fecha Fin Liquidación:</label>
                <input type="date" class="form-control" id="periodoFin" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="codLiquidacion" class="form-label">Código Liquidación (Opcional):</label>
                <input type="text" class="form-control" id="codLiquidacion" placeholder="Código">
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="cantidadDoc" class="form-label">Cantidad Documentos:</label>
                <input type="number" class="form-control" id="cantidadDoc" value="1" min="1" step="1">
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-3">
              <div class="form-group">
                <label for="valorOperaciones" class="form-label">Valor Operaciones ($):</label>
                <input type="number" class="form-control" id="valorOperaciones" step="0.01" oninput="recalcularDCL()" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="montoSinPercepcion" class="form-label">Monto Sin Percepción ($):</label>
                <input type="number" class="form-control" id="montoSinPercepcion" value="0" step="0.01" oninput="recalcularDCL()">
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="descripSinPercepcion" class="form-label">Descripción Sin Percepción (Opcional):</label>
                <input type="text" class="form-control" id="descripSinPercepcion" placeholder="Descripción">
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-3">
              <div class="form-group">
                <label for="subTotal" class="form-label">Sub-Total ($):</label>
                <input type="number" class="form-control" id="subTotal" step="0.01" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="iva" class="form-label">IVA de las Operaciones ($):</label>
                <input type="number" class="form-control" id="iva" step="0.01" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="montoSujetoPercepcion" class="form-label">Monto Sujeto a Percepción ($):</label>
                <input type="number" class="form-control" id="montoSujetoPercepcion" step="0.01" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="ivaPercibido" class="form-label">IVA Percibido 2% ($):</label>
                <input type="number" class="form-control" id="ivaPercibido" step="0.01" required>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-3">
              <div class="form-group">
                <label for="porcentComision" class="form-label">% Comisión:</label>
                <input type="number" class="form-control" id="porcentComision" value="0" min="0" max="100" step="0.01" oninput="recalcularDCL()">
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="comision" class="form-label">Comisión ($):</label>
                <input type="number" class="form-control" id="comision" value="0" step="0.01">
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="ivaComision" class="form-label">IVA Comisión ($):</label>
                <input type="number" class="form-control" id="ivaComision" value="0" step="0.01">
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="liquidoApagar" class="form-label">Líquido a Pagar ($):</label>
                <input type="number" class="form-control" id="liquidoApagar" step="0.01" required>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-12">
              <div class="form-group">
                <label for="observaciones" class="form-label">Observaciones (Opcional):</label>
                <input type="text" class="form-control" id="observaciones" placeholder="Observaciones">
              </div>
            </div>
          </div>

          <h5 class="mt-3">Datos del Responsable que Genera la Liquidación (Extensión)</h5>
          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label for="nombEntrega" class="form-label">Nombre del Responsable:</label>
                <input type="text" class="form-control" id="nombEntrega" placeholder="Nombre de quien genera el DTE" required>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="docuEntrega" class="form-label">Documento del Responsable:</label>
                <input type="text" class="form-control" id="docuEntrega" placeholder="DUI / NIT" required>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="codEmpleado" class="form-label">Código Empleado (Opcional):</label>
                <input type="text" class="form-control" id="codEmpleado" placeholder="Código empleado">
              </div>
            </div>
          </div>

          <div class="text-center mt-3">
            <button type="button" class="btn btn-outline-success round" id="Totalizar">Validar Cálculos</button>
          </div>
        </div>

        <div class="card-body">
          <h4>Apéndices</h4>
          <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover">
              <thead>
                <tr>
                  <th>Campo</th>
                  <th>Etiqueta</th>
                  <th>Valor</th>
                  <th>opt</th>
                </tr>
              </thead>
              <tbody id="TBodyApendices"></tbody>
              <tfoot>
                <tr>
                  <td colspan="4" class="text-center">
                    <button class="btn round btn-outline-primary" onclick="addApendiceRow()" id="btnAddApendices">
                      Agregar Apéndice
                    </button>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <div class="card-footer text-center">
          <div id="results" class="mt-2 mb-4"></div>
          <button class="round btn-lg btn btn-primary mt-2" id="btnSave" disabled>
            Procesar DTE
          </button>
        </div>
      </div>
    </div>

    <%- include('../../Layouts/Footer.ejs') %>
  </div>
</body>
<%- include('../../Layouts/Scripts.ejs') %>
<script src="assets/libs/choices/choices.min.js"></script>
<script>
  const TBodyApendices = document.querySelector("#TBodyApendices");
  const IVA_VAL = Number.parseFloat('<%= VALOR_IVA %>');
  const helper_url = '<%= helper_url %>';
  var distritos = '<%- dptos %>';
  const departamentos = JSON.parse(distritos);
  var selected_departamento = null;
  var selected_municipio = null;
  var selected_distrito = null;
  distritos = '<%- dis %>';
  distritos = JSON.parse(distritos);

  const cargarMunicipios = (index) => {
    let muni = departamentos[index];
    document.querySelector("#municipio").innerHTML = '';
    muni.forEach(element => {
      document.querySelector("#municipio").innerHTML += `<option value="${element.codigo}">${element.Valor}</option>`;
    });
  };

  const recalcularDCL = () => {
    document.querySelector("#btnSave").disabled = true;
    const valorOp = parseFloat(document.getElementById('valorOperaciones').value) || 0;
    const sinPerc = parseFloat(document.getElementById('montoSinPercepcion').value) || 0;
    const pctCom = parseFloat(document.getElementById('porcentComision').value) || 0;
    if (valorOp > 0) {
      const subTotal = fix_number(valorOp - sinPerc, 2);
      const montoSujeto = fix_number(subTotal / (1 + IVA_VAL), 2);
      const iva = fix_number(subTotal - montoSujeto, 2);
      const ivaPercibido = fix_number(montoSujeto * 0.02, 2);
      const comision = fix_number(montoSujeto * (pctCom / 100), 2);
      const ivaComision = fix_number(comision * IVA_VAL, 2);
      const liquido = fix_number(valorOp - ivaPercibido - comision - ivaComision, 2);

      document.getElementById('subTotal').value = subTotal;
      document.getElementById('iva').value = iva;
      document.getElementById('montoSujetoPercepcion').value = montoSujeto;
      document.getElementById('ivaPercibido').value = ivaPercibido;
      document.getElementById('comision').value = comision;
      document.getElementById('ivaComision').value = ivaComision;
      document.getElementById('liquidoApagar').value = liquido > 0 ? liquido : fix_number(valorOp, 2);
    }
  };

  const addApendiceRow = () => {
    const newApendiceRow = document.createElement('tr');
    newApendiceRow.innerHTML = `
      <td><input type="text" class="form-control apendice-campo"></td>
      <td><input type="text" class="form-control apendice-etiqueta"></td>
      <td><input type="text" class="form-control apendice-valor"></td>
      <td><span class="bg-danger badge btn-delete-apendice">Eliminar</span></td>
    `;
    newApendiceRow.querySelector('.btn-delete-apendice').addEventListener('click', () => newApendiceRow.remove());
    TBodyApendices.appendChild(newApendiceRow);
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector("#Totalizar").addEventListener('click', () => {
      const liquido = parseFloat(document.getElementById('liquidoApagar').value);
      const inicio = document.getElementById('periodoInicio').value;
      const fin = document.getElementById('periodoFin').value;
      if (!inicio || !fin || isNaN(liquido) || liquido <= 0) {
        return errorMessage('Complete las fechas del período y los montos de liquidación');
      }
      document.querySelector("#btnSave").disabled = false;
    });

    document.querySelector("#btnSave").addEventListener('click', e => {
      e.target.disabled = true;
      const clientCodActividad = document.getElementById('clientCodActividad');
      const nitVal = document.getElementById('nit').value.replace(/[^0-9]/g, '');
      const nrcVal = document.getElementById('nrc').value.replace(/[^0-9]/g, '');
      const nombreComercialVal = document.getElementById('nombreComercial').value.trim();
      const telefonoVal = document.getElementById('telefono').value.trim();
      const correoVal = document.getElementById('correo').value.trim();

      const receptor = {
        nit: nitVal,
        nrc: nrcVal.length > 0 ? nrcVal : null,
        nombre: document.getElementById('nombre').value.trim(),
        codActividad: clientCodActividad.value,
        descActividad: clientCodActividad.value !== "" ? clientCodActividad.options[clientCodActividad.selectedIndex].text : "",
        nombreComercial: nombreComercialVal.length > 0 ? nombreComercialVal : null,
        tipoEstablecimiento: document.getElementById('tipoEstablecimiento').value,
        direccion: selected_distrito ? {
          departamento: document.getElementById('departamento').value,
          municipio: document.getElementById('municipio').value,
          distrito: selected_distrito,
          complemento: `Distrito de ${document.querySelector("#distrito").value}, ${document.getElementById('complemento').value}`.trim()
        } : null,
        telefono: telefonoVal.length >= 8 ? telefonoVal : null,
        correo: correoVal
      };

      const codLiq = document.getElementById('codLiquidacion').value.trim();
      const cantDoc = parseInt(document.getElementById('cantidadDoc').value);
      const descSinPerc = document.getElementById('descripSinPercepcion').value.trim();
      const obsVal = document.getElementById('observaciones').value.trim();
      const liquidoApagar = fix_number(parseFloat(document.getElementById('liquidoApagar').value), 2);

      const cuerpoDocumento = {
        periodoLiquidacionFechaInicio: document.getElementById('periodoInicio').value,
        periodoLiquidacionFechaFin: document.getElementById('periodoFin').value,
        codLiquidacion: codLiq.length > 0 ? codLiq : null,
        cantidadDoc: !isNaN(cantDoc) && cantDoc > 0 ? cantDoc : null,
        valorOperaciones: fix_number(parseFloat(document.getElementById('valorOperaciones').value), 2),
        montoSinPercepcion: fix_number(parseFloat(document.getElementById('montoSinPercepcion').value) || 0, 2),
        descripSinPercepcion: descSinPerc.length > 0 ? descSinPerc : null,
        subTotal: fix_number(parseFloat(document.getElementById('subTotal').value), 2),
        iva: fix_number(parseFloat(document.getElementById('iva').value), 2),
        montoSujetoPercepcion: fix_number(parseFloat(document.getElementById('montoSujetoPercepcion').value), 2),
        ivaPercibido: fix_number(parseFloat(document.getElementById('ivaPercibido').value), 2),
        comision: fix_number(parseFloat(document.getElementById('comision').value) || 0, 2),
        porcentComision: fix_number(parseFloat(document.getElementById('porcentComision').value) || 0, 2),
        ivaComision: fix_number(parseFloat(document.getElementById('ivaComision').value) || 0, 2),
        liquidoApagar: liquidoApagar,
        totalLetras: String(money_to_string(liquidoApagar)).toLocaleUpperCase(),
        observaciones: obsVal.length > 0 ? obsVal : null
      };

      const codEmp = document.getElementById('codEmpleado').value.trim();
      const extension = {
        nombEntrega: document.getElementById('nombEntrega').value.trim(),
        docuEntrega: document.getElementById('docuEntrega').value.trim(),
        codEmpleado: codEmp.length > 0 ? codEmp : null
      };

      var apendices = null;
      let ApendiceRows = TBodyApendices.querySelectorAll('tr');
      if (ApendiceRows.length > 0) {
        apendices = [];
        ApendiceRows.forEach(row => {
          let apendice = {
            campo: row.querySelector('.apendice-campo').value.trim(),
            etiqueta: row.querySelector('.apendice-etiqueta').value.trim(),
            valor: row.querySelector('.apendice-valor').value.trim(),
          };
          if (apendice.campo.length >= 2 && apendice.etiqueta.length >= 3 && apendice.valor.length > 0) {
            apendices.push(apendice);
          }
        });
        apendices = apendices.length > 0 ? apendices : null;
      }

      let data = {
        dte_type: '09',
        receptor: receptor,
        cuerpoDocumento: cuerpoDocumento,
        extension: extension,
        apendice: apendices
      };

      postData('/pos/procces_dte_manual', data).then(data => {
        if (data.status == 'success') {
          document.querySelector("#results").innerHTML = `
          <h4> DTE: ${data.json.codigo} generada con exito</h4>
          <a href="${helper_url}/utils/services/dte/inline?uuid=${data.json.dte.identificacion.codigoGeneracion}&fecha=${data.json.dte.identificacion.fecEmi}" target="_blank" class="btn round btn-outline-secondary">Ver DTE</a>
          <a href="/pos/getJson/${data.json.id}" target="_blank" class="btn round btn-outline-secondary ml-2 mr-2">Descargar DTE.json</a>`;
          e.target.remove();
          successMessage(data.message);
        } else if (data.status == 'errorMessage') {
          e.target.disabled = false;
          return errorMessage(data.message);
        } else {
          return errorMessage('Lo sentimos, ha ocurrido un error, por favor recarga la página e inténtalo nuevamente');
        }
      });
    });

    document.querySelector("#departamento").addEventListener('change', () => {
      cargarMunicipios(document.querySelector("#departamento").value);
    });

    document.querySelector("#distrito").addEventListener('choice', e => {
      let option = e.detail.choice;
      if (option.value == '') {
        document.querySelector("#municipio").innerHTML += `<option value="00" selected>Otro (Para extranjeros)</option>`;
        document.querySelector("#departamento").value = '00';
        selected_departamento = null;
        selected_municipio = null;
        selected_distrito = null;
      } else if (option.value == '00') {
        selected_departamento = '00';
        selected_municipio = '00';
        selected_distrito = '00';
        cargarMunicipios('00');
        document.querySelector("#municipio").value = '00';
        document.querySelector("#departamento").value = '00';
      } else {
        selected_departamento = option.customProperties.departamento;
        selected_municipio = option.customProperties.municipio;
        selected_distrito = option.customProperties.codigo;
        cargarMunicipios(option.customProperties.departamento);
        document.querySelector("#municipio").value = option.customProperties.municipio;
        document.querySelector("#departamento").value = option.customProperties.departamento;
      }
    });

    new Choices(document.querySelector('#distrito'), { searchChoices: true }).setChoices(distritos);
    new Choices(document.querySelector('#clientCodActividad'), { searchChoices: true });
  });
</script>
</html>

